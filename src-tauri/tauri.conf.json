{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpsPilot",
  "version": "0.1.0",
  "identifier": "io.opspilot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpsPilot",
        "width": 1600,
        "height": 1000,
        "minWidth": 960,
        "minHeight": 600,
        "theme": "Dark",
        "resizable": true,
        "focus": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "SSH, SFTP, tunnels and terminals in one workspace",
    "linux": {
      "deb": {
        "section": "net"
      }
    }
  }
}
