{
  "name": "opspilot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "fonts": "node scripts/vendor-fonts.mjs",
    "postinstall": "node scripts/vendor-fonts.mjs",
    "test:visual": "playwright test visual-check",
    "doctor": "node scripts/doctor.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "tauri": "tauri",
    "bench:filter": "esbuild scripts/bench-filter.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/opspilot/bench-filter.mjs --log-level=warning && node node_modules/.cache/opspilot/bench-filter.mjs",
    "test:keys": "esbuild scripts/test-keys.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/opspilot/test-keys.mjs --log-level=warning && node node_modules/.cache/opspilot/test-keys.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.7",
    "@fontsource/ibm-plex-sans-condensed": "^5.2.6",
    "@fontsource/jetbrains-mono": "^5.2.6",
    "@playwright/test": "^1.56.1",
    "@tauri-apps/cli": "^2.9.1",
    "@types/node": "^22.18.11",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.6.3",
    "vite": "^5.4.21"
  }
}
